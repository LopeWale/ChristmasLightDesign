# Server-side Gemini API configuration (NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Server-side Google Maps Platform API Key (Geocoding v4 building outlines,
# Solar API roof insights, Elevation API, and Street View Static orientation).
# For zero-cost prototyping, generate a Maps Demo Key at:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentskills_v1
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Set to true ONLY for offline CI / deterministic E2E test runs
GEMINI_MOCK_MODE=false

# Multi-view 3D reconstruction worker configuration
# Options: auto (architectural CV/Maps/Gemini on CPU/Apple Silicon, vggt on CUDA) | architectural | vggt | synthetic
RECON_BACKEND=auto
RECON_WORKER_URL=http://127.0.0.1:8001
