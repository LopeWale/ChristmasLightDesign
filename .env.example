# Server-side Gemini API configuration (NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Server-side Google Maps Platform API Key:
# - Enable "Map Tiles API" + "Geocoding API" + "Maps Elevation API" to stream live
#   Google Photorealistic 3D Tiles for any street address via 3DTilesRendererJS.
# - Also supports Solar API & Street View Static API for photo-assisted reconstruction.
# - Zero-cost prototyping Maps Demo Key (Geocoding/Elevation):
#   https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentskills_v1
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Set to true ONLY for offline CI / deterministic E2E test runs
GEMINI_MOCK_MODE=false

# Multi-view 3D reconstruction worker configuration
# Options: auto | da3 (Apple Silicon MPS / CUDA Depth + 3D Splat) | architectural | vggt | synthetic
RECON_BACKEND=auto
RECON_WORKER_URL=http://127.0.0.1:8001
